# Public site settings
NEXT_PUBLIC_SITE_URL=https://your-domain.co.za
# International format, digits only, e.g. 27XXXXXXXXX (leave empty to hide WhatsApp buttons)
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Public business email shown on the site (leave empty to hide)
NEXT_PUBLIC_CONTACT_EMAIL=

# Contact form email delivery (server-side only, never exposed to the browser)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# ---- AI assistant, Smart Intake and enquiry automation ----
# Server-side only. Get a key at https://console.groq.com/keys (free-tier limits are per model: check the Groq console).
GROQ_API_KEY= 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
# Verify the model is available for your account in the Groq console before deploying.
GROQ_MODEL=openai/gpt-oss-120b
# Optional: override the API endpoint (for a proxy or testing)
GROQ_API_URL=
# Where enquiries are stored (default ./.data, outside /public). Use a hosted database on serverless hosts.
ENQUIRY_DATA_DIR=
# Saved enquiries are deleted after this many days (default 365)
DATA_RETENTION_DAYS=365
# Enables GET /api/admin/enquiries with "Authorization: Bearer <token>". Use 24+ random characters; leave empty to disable.
ADMIN_TOKEN=
# Optional social links shown in the footer
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
